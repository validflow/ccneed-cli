{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/hooks/acquisition.mjs",
              "--host",
              "qoder"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/hooks/acquisition.mjs",
              "--host",
              "qoder"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
