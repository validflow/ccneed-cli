{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "process", "command": "node", "args": ["${ZCODE_PLUGIN_ROOT}/hooks/acquisition.mjs", "--host", "zcode"], "timeoutMs": 10000 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "process", "command": "node", "args": ["${ZCODE_PLUGIN_ROOT}/hooks/acquisition.mjs", "--host", "zcode"], "timeoutMs": 10000 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "process", "command": "node", "args": ["${ZCODE_PLUGIN_ROOT}/hooks/acquisition.mjs", "--host", "zcode"], "timeoutMs": 10000 }
        ]
      }
    ]
  }
}
