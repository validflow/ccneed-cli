{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/acquisition.mjs\" --host codex", "commandWindows": "node \"${env:PLUGIN_ROOT}/hooks/acquisition.mjs\" --host codex", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command",
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/acquisition.mjs\" --host codex", "commandWindows": "node \"${env:PLUGIN_ROOT}/hooks/acquisition.mjs\" --host codex", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|exec_command",
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/acquisition.mjs\" --host codex", "commandWindows": "node \"${env:PLUGIN_ROOT}/hooks/acquisition.mjs\" --host codex", "timeout": 10 }
        ]
      }
    ]
  }
}
